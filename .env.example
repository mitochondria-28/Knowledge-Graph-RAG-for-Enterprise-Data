# ── LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...         # Used for embeddings (Phase 5+)

# ── Neo4j (Phase 4+) ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── PostgreSQL / pgvector (Phase 5+) ─────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/kg_rag

# ── Ingestion settings ────────────────────────────────────────────
CORPUS_DIR=corpus
OUTPUT_DIR=output
CHUNK_SIZE=500          # Target chunk size in tokens
CHUNK_OVERLAP=100       # Overlap between consecutive chunks in tokens

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
