# ── Authentication (Phase 14+) ───────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
# Set this to your Google OAuth client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Database ─────────────────────────────────────────────────────
# Local dev: leave blank → SQLite (auth.db created automatically)
# Production (Vercel): set to your PostgreSQL connection string, e.g. from Neon
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Vercel / Serverless ───────────────────────────────────────────
# Project root is read-only on Vercel — write uploads to /tmp instead
TEMP_DIR=/tmp

# ── LLM ──────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...         # Used for embeddings (Phase 5+)

# ── Neo4j (Phase 4+) ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── PostgreSQL / pgvector (Phase 5+) ─────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/kg_rag

# ── Ingestion settings ────────────────────────────────────────────
CORPUS_DIR=corpus
OUTPUT_DIR=output
CHUNK_SIZE=500          # Target chunk size in tokens
CHUNK_OVERLAP=100       # Overlap between consecutive chunks in tokens

# ── Logging / Observability ──────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json (default) or text (for local dev)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Jaeger / Tempo
# OTEL_SERVICE_NAME=kg-rag-api
