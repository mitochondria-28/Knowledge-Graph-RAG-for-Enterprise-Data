{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "ui/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/auth/(.*)",        "dest": "/api/index.py" },
    { "src": "/ask",              "dest": "/api/index.py" },
    { "src": "/documents(.*)",    "dest": "/api/index.py" },
    { "src": "/health",           "dest": "/api/index.py" },
    { "src": "/ready",            "dest": "/api/index.py" },
    { "src": "/metrics",          "dest": "/api/index.py" },
    { "src": "/docs",             "dest": "/api/index.py" },
    { "src": "/redoc",            "dest": "/api/index.py" },
    { "src": "/openapi.json",     "dest": "/api/index.py" },
    { "src": "/assets/(.*)",      "dest": "/ui/assets/$1" },
    { "src": "/(favicon\\.svg|favicon\\.ico|robots\\.txt|manifest\\.json)(.*)", "dest": "/ui/$1$2" },
    { "src": "/(.*)",             "dest": "/ui/index.html" }
  ]
}
